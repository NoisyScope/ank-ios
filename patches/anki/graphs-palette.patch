diff --git a/ts/routes/graphs/palette.ts b/ts/routes/graphs/palette.ts
new file mode 100644
index 0000000..aefb3d7
--- /dev/null
+++ b/ts/routes/graphs/palette.ts
@@ -0,0 +1,16 @@
+// Copyright: Ankitects Pty Ltd and contributors
+// License: GNU AGPL, version 3 or later; http://www.gnu.org/licenses/agpl.html
+
+// Ank-ios: one palette for every graph, built on the calendar's blues. A single warm
+// accent marks the "bad" end (lapses, Again, high difficulty) so it still stands out.
+import { interpolateBlues, interpolateRgbBasis } from "d3";
+
+export const accent = "#e4805f";
+export const blue = (t: number): string => interpolateBlues(t);
+/** 0 is bad, 1 is good. */
+export const goodness = interpolateRgbBasis([accent, "#f2c3ae", "#a9cce3", "#2a6fb0"]);
+export const learning = interpolateRgbBasis(["#9fd3d6", "#4fa6ad"]);
+export const filtered = interpolateRgbBasis(["#b9b6dc", "#7d77b8"]);
+/** Again, Hard, Good, Easy. */
+export const buttons = [accent, "#f2c3ae", blue(0.55), blue(0.85)];
+export const lapse = interpolateRgbBasis(["#f2b8a2", accent]);
